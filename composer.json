{
    "name": "viancen/eazycv-client",
    "type": "library",
    "version": "1.4.0",
    "description": "Official PHP HTTP client for the EazyCV API",
    "keywords": [
        "eazycv",
        "api",
        "client",
        "http"
    ],
    "homepage": "https://github.com/viancen/eazycv-client",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "EazyCV development team",
            "email": "info@eazycv.nl",
            "homepage": "https://www.eazycv.nl",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "info@eazycv.nl",
        "issues": "https://github.com/viancen/eazycv-client/issues",
        "source": "https://github.com/viancen/eazycv-client"
    },
    "require": {
        "php": ">=7.3",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-0": {
            "EazycvClient": "src/"
        },
        "classmap": [
            "src/EazycvClient/Exceptions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "EazycvClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
